# Environment Configuration for Quevia (Local Development)

# Application Environment
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Backend API Configuration
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=quevia_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/quevia_dev?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication
JWT_SIGNING_KEY=quevia-development-secret-key-32-bytes-minimum!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h
GUEST_TOKEN_TTL=30m

# SMTP / Email (Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Quevia Notification <no-reply@quevia.app>"
MAILPIT_PORT=8025

# Operation Limits
IDEMPOTENCY_TTL=24h
